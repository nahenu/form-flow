# Copy to .env.local for local development.

# Random string used to sign sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Public URL of the app (used by auth callbacks and the embed snippet).
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Leave empty locally to use the built-in PGlite database in ./.data.
# In production, set it to a Postgres URL (e.g. from Neon) and run `npm run db:migrate`.
DATABASE_URL=
